//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  XAU Volume Bubble + VWAP  (v3)
//
//  • A bubble is drawn on every closed bar whose volume is unusually high
//    (≥ N × its recent average). The bubble sits ON THAT BAR'S VWAP PRICE
//    (volume-weighted price inside the bar, from lower-timeframe data; HLC3
//    when no intrabar data exists). Bubble size = how big the volume is.
//    The real volume number is printed inside the bubble.
//  • Bubble colour = candle direction (green up, red down). No buy/sell
//    estimation is used.
//  • Session / Week / Month VWAP line with optional ±σ band lines.
//
//  Note: on XAUUSD CFD feeds the broker's "volume" is a tick count. This
//  script shows that number as-is; it does not estimate anything from it.
// ─────────────────────────────────────────────────────────────────────────────
indicator("XAU Volume Bubble + VWAP", shorttitle = "VolBubble·VWAP", overlay = true, max_labels_count = 500)

// ═════════════════════════════ INPUTS ═══════════════════════════════════════
const string G_B  = "Volume Bubble"
const string G_VW = "VWAP"
const string G_C  = "Colours"

bool   showBub  = input.bool(true, "Show bubbles", group = G_B)
int    avgLen   = input.int(20, "Average volume length", minval = 5, group = G_B)
float  minMult  = input.float(2.0, "Bubble when volume ≥ × average", minval = 1.0, step = 0.1, group = G_B,
     tooltip = "Small bubble from this multiple, medium from +1, large from +2. Raise it to see fewer bubbles.")
bool   showTxt  = input.bool(true, "Volume number inside bubble", group = G_B)
string ltfMode  = input.string("Auto", "Intrabar timeframe (bubble price)", options = ["Auto", "1", "5", "15", "60"], group = G_B,
     tooltip = "Used only to find each bar's own VWAP price. Auto: chart ≤15m → 1m, ≤4h → 5m, otherwise 60m. When it is not lower than the chart timeframe, HLC3 is used.")
int    maxBars  = input.int(500, "Draw bubbles on the last N bars", minval = 50, maxval = 5000, group = G_B)

bool   showVwap  = input.bool(true, "Show VWAP", group = G_VW)
string vwAnchor  = input.string("Session", "Anchor", options = ["Session", "Week", "Month"], group = G_VW)
bool   showBands = input.bool(false, "Show ±σ band lines", group = G_VW)
float  band1     = input.float(1.0, "Band 1 (σ)", minval = 0.1, step = 0.1, group = G_VW)
float  band2     = input.float(2.0, "Band 2 (σ)", minval = 0.1, step = 0.1, group = G_VW)

color  cUp   = input.color(#00E676, "Up bar bubble", group = G_C)
color  cDn   = input.color(#FF1744, "Down bar bubble", group = G_C)
color  cVwap = input.color(#B388FF, "VWAP", group = G_C)

// ═════════════════════════════ HELPERS ══════════════════════════════════════
color noCol = color.new(color.black, 100)

f_fmt(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.#") + "B" : a >= 1e6 ? str.tostring(v / 1e6, "#.#") + "M" : a >= 1e3 ? str.tostring(v / 1e3, "#.#") + "K" : str.tostring(v, "#")

// ═════════════════════════════ BAR VWAP PRICE (bubble position) ════════════
int    chartSec = timeframe.in_seconds()
string autoLtf  = chartSec <= 900 ? "1" : chartSec <= 14400 ? "5" : "60"
string ltf      = ltfMode == "Auto" ? autoLtf : ltfMode
bool   ltfLower = timeframe.in_seconds(ltf) < chartSec

[ibH, ibL, ibC, ibV] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, close, volume], ignore_invalid_timeframe = true)
int ibN = na(ibV) ? 0 : ibV.size()

float pv = 0.0
float vv = 0.0
if ltfLower and ibN > 0
    for i = 0 to ibN - 1
        float v = nz(ibV.get(i))
        pv += v * (ibH.get(i) + ibL.get(i) + ibC.get(i)) / 3.0
        vv += v
float barVwap = vv > 0 ? pv / vv : hlc3

// ═════════════════════════════ VOLUME BUBBLES ═══════════════════════════════
float avgVol = ta.sma(volume, avgLen)[1]          // average of the previous bars
float mult   = avgVol > 0 ? nz(volume) / avgVol : 0.0
int   tier   = mult >= minMult + 2 ? 3 : mult >= minMult + 1 ? 2 : mult >= minMult ? 1 : 0
bool  recent = bar_index >= last_bar_index - maxBars

if showBub and tier > 0 and barstate.isconfirmed and recent
    color  c      = close >= open ? cUp : cDn
    string bubSz  = tier == 3 ? size.huge : tier == 2 ? size.large : size.normal
    string txtSz  = tier == 3 ? size.normal : tier == 2 ? size.small : size.tiny
    string tip    = "Volume: " + str.tostring(volume, format.volume) + "  (×" + str.tostring(mult, "#.0") + " avg)" +
         "\nBar VWAP: " + str.tostring(barVwap, format.mintick) + (vv > 0 ? "" : " (HLC3)")
    // bubble
    label.new(bar_index, barVwap, "●", style = label.style_label_center, color = noCol,
         textcolor = color.new(c, tier == 3 ? 25 : tier == 2 ? 35 : 45), size = bubSz, tooltip = tip)
    // real volume number in the centre
    if showTxt
        label.new(bar_index, barVwap, f_fmt(nz(volume)), style = label.style_label_center, color = noCol,
             textcolor = color.white, size = txtSz, text_formatting = text.format_bold, tooltip = tip)

// ═════════════════════════════ VWAP ═════════════════════════════════════════
bool chD = timeframe.change("D")
bool chW = timeframe.change("W")
bool chM = timeframe.change("M")
bool newAnchor = vwAnchor == "Session" ? chD : vwAnchor == "Week" ? chW : chM

var float sPV  = 0.0
var float sV   = 0.0
var float sPV2 = 0.0
if newAnchor
    sPV  := 0.0
    sV   := 0.0
    sPV2 := 0.0
sPV  += hlc3 * nz(volume)
sV   += nz(volume)
sPV2 += hlc3 * hlc3 * nz(volume)
int   anchorSec = vwAnchor == "Session" ? 86400 : vwAnchor == "Week" ? 604800 : 2419200
bool  vwapOk  = chartSec < anchorSec
float vwapVal = vwapOk and sV > 0 ? sPV / sV : na
float vwapSd  = vwapOk and sV > 0 ? math.sqrt(math.max(sPV2 / sV - vwapVal * vwapVal, 0.0)) : na

bool bandsOn = showVwap and showBands
plot(showVwap ? vwapVal : na, "VWAP", color = newAnchor ? na : cVwap, linewidth = 2)
plot(bandsOn ? vwapVal + band1 * vwapSd : na, "VWAP +1σ", color = newAnchor ? na : color.new(cVwap, 60))
plot(bandsOn ? vwapVal - band1 * vwapSd : na, "VWAP −1σ", color = newAnchor ? na : color.new(cVwap, 60))
plot(bandsOn ? vwapVal + band2 * vwapSd : na, "VWAP +2σ", color = newAnchor ? na : color.new(cVwap, 78))
plot(bandsOn ? vwapVal - band2 * vwapSd : na, "VWAP −2σ", color = newAnchor ? na : color.new(cVwap, 78))

// ═════════════════════════════ DATA WINDOW & ALERTS ═════════════════════════
plot(mult, "Volume × average", display = display.data_window)
plot(barVwap, "Bar VWAP", display = display.data_window)

bool bubNow = barstate.isconfirmed and tier > 0
alertcondition(bubNow and close >= open, "Volume bubble – up bar", "{{ticker}}: high-volume UP bar, volume {{volume}}")
alertcondition(bubNow and close < open, "Volume bubble – down bar", "{{ticker}}: high-volume DOWN bar, volume {{volume}}")
alertcondition(bubNow and tier == 3, "Volume bubble – large", "{{ticker}}: very high volume bar, volume {{volume}}")
